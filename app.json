{
  "expo": {
    "name": "ECG Monitor",
    "slug": "yakapappecg",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo2.jpg",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/logo2.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yakap.ecgmonitor"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo2.jpg",
        "backgroundColor": "#ffffff"
      },
      "package": "com.yakap.ecgmonitor",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/logo2.jpg"
    },
    "plugins": [
      "expo-router",
      "expo-updates"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "6568b748-f0e2-4265-b1d1-b15fe9478a07"
      }
    },
    "owner": "expmjbeltran13",
    "runtimeVersion": "1.0.0",
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/6568b748-f0e2-4265-b1d1-b15fe9478a07"
    }
  }
}
